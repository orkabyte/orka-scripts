{$IFNDEF SCRIPT_CHAIN}
{$IFDEF SCRIPT_GUI}
type
  TReanimationConfig = record(TScriptForm)
    HeadLabel: TLabel;
    PotionLabel: TLabel;
    HeadSelector: TComboBox;
    UseSpecsCheckbox: TLabeledCheckBox;
    QuickPrayerCheckbox: TLabeledCheckBox;
    PotionCheckbox: TLabeledCheckBox;
    PotionSelector: TComboBox;
    BHRunsCheckbox: TLabeledCheckBox;
    CheckSettingsCheckbox: TLabeledCheckBox;
    BHLogLabel: TLabel;
    BHLogSelector: TComboBox;
    BHSeedLabel: TLabel;
    BHSeedEdit: TEdit;
    BHBestLogCheckbox: TLabeledCheckBox;
    BHCraftCheckbox: TLabeledCheckBox;
    BHIntervalLabel: TLabel;
    BHNowRadio: TRadioButton;
    BHNowLabel: TLabel;
    BHLaterRadio: TRadioButton;
    BHLaterLabel: TLabel;

    // Discord
    DiscordWebhookEdit: TLabeledEdit;
    DiscordEnabledCheckbox: TLabeledCheckBox;
    DiscordAnonymousCheckbox: TLabeledCheckBox;
    DiscordTestButton: TButton;
  end;

var
  ReanimationConfig: TReanimationConfig;

(**
 * SaveConfig
 *
 * Saves the current GUI configuration settings to the script config file.
 *)
procedure SaveConfig();
begin
  if not Config.IsSetup then
    Config.Setup('orka-reanimation');

  Config.Put('headType', ReanimationConfig.HeadSelector.GetItemIndex());
  Config.Put('useSpecs', ReanimationConfig.UseSpecsCheckbox.IsChecked());
  Config.Put('useQuickPrayers', ReanimationConfig.QuickPrayerCheckbox.IsChecked());
  Config.Put('useBankPotion', ReanimationConfig.PotionCheckbox.IsChecked());
  Config.Put('bankPotionType', ReanimationConfig.PotionSelector.GetItemIndex());
  Config.Put('doBHRuns', ReanimationConfig.BHRunsCheckbox.IsChecked());
  Config.Put('checkGameSettings', False);

  // Save birdhouse settings
  Config.Put('bhLogType', Ord(BirdHouseRunner.LogType));
  Config.Put('bhSeed', ToStr(BirdHouseRunner.Seed));
  Config.Put('bhUseBestLog', BirdHouseRunner.AlwaysUseBestLog);
  Config.Put('bhCraftWhileWalking', BirdHouseRunner.NeedClockworks);

  // Discord settings
  Config.Put('discordEnabled', ReanimationConfig.DiscordEnabledCheckbox.IsChecked());
  Config.Put('discordAnonymous', ReanimationConfig.DiscordAnonymousCheckbox.IsChecked());
  Config.Put('discordWebhook', ReanimationConfig.DiscordWebhookEdit.GetText());
end;

(**
 * LoadConfig
 *
 * Loads configuration settings from the script config file into the GUI.
 * Sets default values if config entries are missing.
 *)
procedure LoadConfig();
var
  potionIndex: Int32;
begin
  if not Config.IsSetup then
    Config.Setup('orka-reanimation');

  if Config.Has('headType') then
    ReanimationConfig.HeadSelector.SetItemIndex(Config.GetInt('headType'))
  else
    ReanimationConfig.HeadSelector.SetItemIndex(8); // Default to Dragon

  if Config.Has('useSpecs') then
    ReanimationConfig.UseSpecsCheckbox.SetChecked(Config.GetBoolean('useSpecs'))
  else
    ReanimationConfig.UseSpecsCheckbox.SetChecked(True);

  if Config.Has('useQuickPrayers') then
    ReanimationConfig.QuickPrayerCheckbox.SetChecked(Config.GetBoolean('useQuickPrayers'))
  else
    ReanimationConfig.QuickPrayerCheckbox.SetChecked(False);

  potionIndex := 0; // Default to combat potion
  if Config.Has('bankPotionType') then
  begin
    potionIndex := Config.GetInt('bankPotionType');
    if potionIndex < 0 then
      potionIndex := 0
    else if potionIndex > Ord(High(EPotionType)) then
      potionIndex := 0;
  end;
  ReanimationConfig.PotionSelector.SetItemIndex(potionIndex);

  if Config.Has('useBankPotion') then
    ReanimationConfig.PotionCheckbox.SetChecked(Config.GetBoolean('useBankPotion'))
  else
    ReanimationConfig.PotionCheckbox.SetChecked(False);

  if Config.Has('doBHRuns') then
    ReanimationConfig.BHRunsCheckbox.SetChecked(Config.GetBoolean('doBHRuns'));

  // Load birdhouse settings and update GUI defaults
  if Config.Has('bhLogType') then
  begin
    BirdHouseRunner.LogType := ERSLogType(Config.GetInt('bhLogType'));
    BHIncludeGUILogType := BirdHouseRunner.LogType;
  end;

  if Config.Has('bhSeed') then
  begin
    BirdHouseRunner.Seed := Config.GetString('bhSeed');
    BHIncludeGUISeed := BirdHouseRunner.Seed;
  end;

  if Config.Has('bhUseBestLog') then
  begin
    BirdHouseRunner.AlwaysUseBestLog := Config.GetBoolean('bhUseBestLog');
    BHIncludeGUIUseBestLog := BirdHouseRunner.AlwaysUseBestLog;
  end;

  if Config.Has('bhCraftWhileWalking') then
    BirdHouseRunner.NeedClockworks := Config.GetBoolean('bhCraftWhileWalking')
  else if Config.Has('bhNeedClockworks') then
    BirdHouseRunner.NeedClockworks := Config.GetBoolean('bhNeedClockworks');
  BHIncludeGUICraftWhileNav := BirdHouseRunner.NeedClockworks;

  BHIncludeGUIRunIntervalMinutes := 50; // Default to run later

  if Config.Has('bhTaskInterval') then
  begin
    BirdHouseRunner.TaskInterval := Config.GetInt('bhTaskInterval');
    if BirdHouseRunner.TaskInterval = 0 then
      BHIncludeGUIRunIntervalMinutes := 0;
  end;
end;

(**
 * TReanimationConfig.StartScript
 *
 * GUI Start button callback.
 * Applies GUI settings to the bot configuration and starts the script.
 *
 * @param sender The object that triggered the event
 *)
procedure TReanimationConfig.StartScript(sender: TObject); override;
var
  potionIndex: Int32;
begin
  Bot.CheckGameSettings := Self.CheckSettingsCheckbox.IsChecked();
  Bot.HeadType := EHeadType(Self.HeadSelector.GetItemIndex());
  Bot.DoBHRuns := Self.BHRunsCheckbox.IsChecked();
  Bot.UseSpecs := Self.UseSpecsCheckbox.IsChecked();
  Bot.UseQuickPrayers := Self.QuickPrayerCheckbox.IsChecked();
  Bot.UseBankPotion := Self.PotionCheckbox.IsChecked();

  potionIndex := Self.PotionSelector.GetItemIndex();
  if potionIndex < 0 then
    potionIndex := 0
  else if potionIndex > Ord(High(EPotionType)) then
    potionIndex := Ord(High(EPotionType));
  Bot.BankPotion := EPotionType(potionIndex);

  // Discord notifications
  Bot.UseDiscord := Self.DiscordEnabledCheckbox.IsChecked();
  Bot.AnonymousScreenshots := Self.DiscordAnonymousCheckbox.IsChecked();
  if Bot.UseDiscord then
  begin
    Discord.Setup();
    Discord.SetWebhook(Self.DiscordWebhookEdit.GetText());
    Discord.SetUsername(SCRIPT_NAME);
    Discord.SetAvatar('https://raw.githubusercontent.com/orkabyte/orka-scripts/refs/heads/main/orka-reanimation/orka-reanimation-disc-notification.jpeg');
  end;

  SaveConfig();
  inherited;
end;

(**
 * TReanimationConfig.CreateBirdhouseRunSettings
 *
 * Creates the "Birdhouse Settings" tab in the GUI.
 * Includes controls for logs, seeds, and run behavior.
 *
 * @return The created tab sheet
 *)
function TReanimationConfig.CreateBirdhouseRunSettings(): TTabSheet; override;
  type TReanimationConfig = TReanimationConfig;

  (**
   * _BHSeedChanged
   * Callback for seed text edit changes.
   *)
  procedure TReanimationConfig._BHSeedChanged(sender: TObject);
  var
    seed: TEdit;
  begin
    seed := sender;
    BirdHouseRunner.Seed := seed.getText();
  end;

  (**
   * _BHLogTypeChanged
   * Callback for log type dropdown changes.
   *)
  procedure TReanimationConfig._BHLogTypeChanged(sender: TObject);
  var
    combobox: TComboBox;
  begin
    combobox := sender;
    BirdHouseRunner.LogType := ERSLogType(comboBox.getItemIndex());
  end;

  (**
   * _BHCheckBoxChanged
   * Callback for birdhouse configuration checkboxes.
   *)
  procedure TReanimationConfig._BHCheckBoxChanged(sender: TObject);
  var
    checkBox: TCheckBox;
    isChecked: Boolean;
  begin
    checkBox := sender;
    isChecked := checkBox.IsChecked();
    case checkBox.getName() of
      'bh_extraclockworkcb_checkbox': BirdHouseRunner.NeedClockworks := isChecked;
      'bh_bestlogcb_checkbox': BirdHouseRunner.AlwaysUseBestLog := isChecked;
    end;
  end;

  (**
   * _BHRadioChanged
   * Callback for birdhouse timing radio buttons.
   *)
  procedure TReanimationConfig._BHRadioChanged(sender: TObject);
  var
    radio: TRadioButton;
  begin
    radio := sender;
    case radio.getName() of
      'bh_nowradio': BirdHouseRunner.TaskInterval := 0;
      'bh_laterradio': BirdHouseRunner.TaskInterval := 50 * ONE_MINUTE;
    end;
  end;

var
  baseLeft, baseTop, controlWidth, spacing, indent, labelGap, currentTop: Int32;
begin
  Self.AddTab('Birdhouse Settings');
  Result := Self.Tabs[High(Self.Tabs)];

  controlWidth := TControl.AdjustToDPI(240);
  baseLeft := TControl.AdjustToDPI(60);
  baseTop := TControl.AdjustToDPI(170);
  spacing := TControl.AdjustToDPI(10);
  indent := TControl.AdjustToDPI(18);
  labelGap := TControl.AdjustToDPI(4);
  currentTop := baseTop;

  with Self.BHLogLabel do
  begin
    Create(Result);
    SetCaption('Log type to use:');
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  with Self.BHLogSelector do
  begin
    Create(Result);
    SetLeft(baseLeft);
    SetTop(Self.BHLogLabel.GetTop() + Self.BHLogLabel.GetHeight() + labelGap);
    SetWidth(controlWidth);
    SetStyle(csDropDownList);
    AddItem('Regular', nil);
    AddItem('Oak', nil);
    AddItem('Willow', nil);
    AddItem('Teak', nil);
    AddItem('Maple', nil);
    AddItem('Mahogany', nil);
    AddItem('Yew', nil);
    AddItem('Magic tree', nil);
    AddItem('Redwood', nil);
    BirdHouseRunner.LogType := BHIncludeGUILogType;
    SetItemIndex(Ord(BirdHouseRunner.LogType));
    SetOnChange(@Self._BHLogTypeChanged);
  end;

  currentTop := Self.BHLogSelector.GetTop() + Self.BHLogSelector.GetHeight() + spacing;

  with Self.BHSeedLabel do
  begin
    Create(Result);
    SetCaption('Seed (just the name, e.g. potato):');
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  with Self.BHSeedEdit do
  begin
    Create(Result);
    SetLeft(baseLeft);
    SetTop(Self.BHSeedLabel.GetTop() + Self.BHSeedLabel.GetHeight() + labelGap);
    SetWidth(controlWidth);
    SetName('bh_seed');
    BirdHouseRunner.Seed := ToStr(BHIncludeGUISeed).Replace('Barely', 'Barley', [rfIgnoreCase]).Before(' ');
    SetText(ToStr(BirdHouseRunner.Seed));
    SetOnChange(@Self._BHSeedChanged);
    GetFont.SetColor($000000);
  end;

  currentTop := Self.BHSeedEdit.GetTop() + Self.BHSeedEdit.GetHeight() + spacing;

  with Self.BHBestLogCheckbox do
  begin
    Create(Result);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('bh_bestlogcb');
    SetCaption('Always use best log');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    BirdHouseRunner.AlwaysUseBestLog := BHIncludeGUIUseBestLog;
    SetChecked(BirdHouseRunner.AlwaysUseBestLog);
    CheckBox.setOnChange(@Self._BHCheckBoxChanged);
  end;

  currentTop := Self.BHBestLogCheckbox.GetTop() + Self.BHBestLogCheckbox.GetHeight() + spacing;

  with Self.BHCraftCheckbox do
  begin
    Create(Result);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('bh_extraclockworkcb');
    SetCaption('Craft birdhouses while navigating (requires clockwork in bank)');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    BirdHouseRunner.NeedClockworks := BHIncludeGUICraftWhileNav;
    SetChecked(BirdHouseRunner.NeedClockworks);
    CheckBox.setOnChange(@Self._BHCheckBoxChanged);
  end;

  currentTop := Self.BHCraftCheckbox.GetTop() + Self.BHCraftCheckbox.GetHeight() + spacing + TControl.AdjustToDPI(10);

  with Self.BHIntervalLabel do
  begin
    Create(Result);
    SetCaption('When should the next run start?');
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  currentTop := Self.BHIntervalLabel.GetTop() + Self.BHIntervalLabel.GetHeight() + labelGap;

  with Self.BHNowRadio do
  begin
    Create(Result);
    SetName('bh_nowradio');
    SetLeft(baseLeft + indent);
    SetTop(currentTop);
    SetWidth(TControl.AdjustToDPI(18));
    SetCaption('');
    SetOnClick(@Self._BHRadioChanged);
  end;

  with Self.BHNowLabel do
  begin
    Create(Result);
    SetCaption('Do a run now');
    SetLeft(Self.BHNowRadio.GetLeft() + Self.BHNowRadio.GetWidth());
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  currentTop := Self.BHNowRadio.GetTop() + Self.BHNowRadio.GetHeight() + labelGap;

  with Self.BHLaterRadio do
  begin
    Create(Result);
    SetName('bh_laterradio');
    SetLeft(baseLeft + indent);
    SetTop(currentTop);
    SetWidth(TControl.AdjustToDPI(18));
    SetCaption('');
    SetOnClick(@Self._BHRadioChanged);
  end;

  with Self.BHLaterLabel do
  begin
    Create(Result);
    SetCaption('Do a run later (in about 50-60 minutes)');
    SetLeft(Self.BHLaterRadio.GetLeft() + Self.BHLaterRadio.GetWidth());
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  BirdHouseRunner.TaskInterval := BHIncludeGUIRunIntervalMinutes;

  if BHIncludeGUIRunIntervalMinutes > 0 then
  begin
    Self.BHLaterRadio.setState(TCheckBoxState.cbChecked);
    Self.BHNowRadio.setState(TCheckBoxState.cbUnchecked);
    BirdHouseRunner.TaskInterval := 50 * ONE_MINUTE;
  end
  else
  begin
    Self.BHLaterRadio.setState(TCheckBoxState.cbUnchecked);
    Self.BHNowRadio.setState(TCheckBoxState.cbChecked);
    BirdHouseRunner.TaskInterval := 0;
  end;
end;

(**
 * SetChildsBoldFont
 *
 * Recursively applies bold font styling to a control and all its children.
 *
 * @param ctrl  The control to style
 *)
procedure SetChildsBoldFont(ctrl: TControl);
var
  i: Int32;
  child: TControl;
begin
  for i := 0 to ctrl.getComponentCount() - 1 do
  begin
    child := ctrl.GetComponent(i);
    SetChildsBoldFont(child);
  end;
  ctrl.GetFont().SetStyle([fsBold]);
end;

(**
 * TReanimationConfig.OpenWebhookHelp
 *
 * Opens the Discord webhook setup guide in the user's browser.
 *)
procedure TReanimationConfig.OpenWebhookHelp(sender: TObject);
begin
  sender; // suppress unused warning
  OpenWebPage('https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks');
end;

(**
 * TReanimationConfig.TestDiscordWebhook
 *
 * Tests the Discord webhook by sending a test message.
 *)
procedure TReanimationConfig.TestDiscordWebhook(sender: TObject);
var
  testClient: TDiscordClient;
begin
  sender; // suppress unused warning
  testClient.Setup();
  if testClient.SetWebhook(Self.DiscordWebhookEdit.GetText()) then
  begin
    testClient.SetUsername(SCRIPT_NAME);
    testClient.SetAvatar('https://raw.githubusercontent.com/orkabyte/orka-scripts/refs/heads/main/orka-fletcher/assets/orka-fletcher-disc-notification.jpeg');
    testClient.Webhook.Content := 'Webhook test successful!';
    if testClient.Send() then
      Self.DiscordTestButton.SetCaption('Success!')
    else
      Self.DiscordTestButton.SetCaption('Send Failed');
  end
  else
    Self.DiscordTestButton.SetCaption('Invalid URL');
  testClient.Free();
end;

(**
 * TReanimationConfig.Run
 *
 * Initializes and displays the script configuration GUI.
 *)
procedure TReanimationConfig.Run(); override;
var
  tab, accountTab, abTab, wlTab, discordTab: TTabSheet;
  helpBtn: TButton;
  Font: TFont;
  Img: TPicture;
  BGImg: TImage;
  baseLeft, baseTop, controlWidth, spacing, indent, labelGap, currentTop: Int32;
  accountPanel, limitPanel, riPanel, vPanel: TPanel;
  amPassPanel, amWorldsPanel: TPanel;
  amAddBtn, amSaveBtn, amDeleteBtn: TButton;
  actionLimitPanel, timeLimitPanel, vEnabledPanel, vTimePanel: TControl;
  offset, currentY: Int32;
  i: Int32;
  child: TControl;
begin
  // 880x510 keeps the page area at the background's 1376x768 aspect ratio,
  // so the stretched image renders without squeeze
  Self.Setup('Orka Reanimation', [880, 510]);
  Self.Start.setOnClick(@Self.StartScript);

  Font.Init();
  Font.setName('Verdana');
  Font.SetQuality(fqCleartype);
  Self.Form.setFont(Font);
  Self.PageControl.SetFont(Font);
  Font.Free();

  // Set background on PageControl (like aeroguardians) so TLabeledCheckBox panels appear transparent
  // Yes, I stole this from Flight. Please don't tell him :)
  if not FileExists(AppPath + 'Resources\OrkaReanimationBG.jpeg') then
    DownloadToFile('https://raw.githubusercontent.com/orkabyte/orka-scripts/refs/heads/main/orka-reanimation/orka-reanimation-bg.jpeg', AppPath + 'Resources\OrkaReanimationBG.jpeg');

  if FileExists(AppPath + 'Resources\OrkaReanimationBG.jpeg') then
  begin
    Img.Init();
    Img.LoadFromFile(AppPath + 'Resources\OrkaReanimationBG.jpeg');
    with BGImg do
    begin
      Init(Self.PageControl);
      SetParent(Self.PageControl);
      SetPicture(Img);
      SetAlign(alClient);
      SetStretch(True);
    end;
  end;

  Self.AddTab('Script Settings');
  tab := Self.Tabs[High(Self.Tabs)];

  controlWidth := TControl.AdjustToDPI(240);
  baseLeft := TControl.AdjustToDPI(60);
  baseTop := TControl.AdjustToDPI(170);
  spacing := TControl.AdjustToDPI(10);
  indent := TControl.AdjustToDPI(18);
  labelGap := TControl.AdjustToDPI(4);
  currentTop := baseTop;

  with Self.HeadLabel do
  begin
    Create(tab);
    SetCaption('Ensouled head:');
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  with Self.HeadSelector do
  begin
    Create(tab);
    SetLeft(baseLeft);
    SetTop(Self.HeadLabel.GetTop() + Self.HeadLabel.GetHeight() + labelGap);
    SetWidth(controlWidth);
    SetStyle(csDropDownList);
    AddItem('Abyssal', nil);
    AddItem('Aviansie', nil);
    AddItem('Bear', nil);
    AddItem('Bloodveld', nil);
    AddItem('Chaos Druid', nil);
    AddItem('Dagannoth', nil);
    AddItem('Demon', nil);
    AddItem('Dog', nil);
    AddItem('Dragon', nil);
    AddItem('Elf', nil);
    AddItem('Giant', nil);
    AddItem('Goblin', nil);
    AddItem('Hellhound', nil);
    AddItem('Horror', nil);
    AddItem('Imp', nil);
    AddItem('Kalphite', nil);
    AddItem('Minotaur', nil);
    AddItem('Monkey', nil);
    AddItem('Ogre', nil);
    AddItem('Scorpion', nil);
    AddItem('Troll', nil);
    AddItem('TzHaar', nil);
    AddItem('Unicorn', nil);
    SetItemIndex(8); // Default to Dragon
  end;

  currentTop := Self.HeadSelector.GetTop() + Self.HeadSelector.GetHeight() + spacing;

  with Self.UseSpecsCheckbox do
  begin
    Create(tab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('use_specs');
    SetCaption('Use special attacks');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetChecked(True);
  end;

  currentTop := Self.UseSpecsCheckbox.GetTop() + Self.UseSpecsCheckbox.GetHeight() + spacing;

  with Self.QuickPrayerCheckbox do
  begin
    Create(tab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('quick_prayer');
    SetCaption('Enable quick prayers');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetChecked(False);
  end;

  currentTop := Self.QuickPrayerCheckbox.GetTop() + Self.QuickPrayerCheckbox.GetHeight() + spacing;

  with Self.PotionCheckbox do
  begin
    Create(tab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('bank_potion');
    SetCaption('Drink combat potion (1-dose) when banking');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetChecked(False);
  end;

  currentTop := Self.PotionCheckbox.GetTop() + Self.PotionCheckbox.GetHeight() + spacing;

  with Self.PotionLabel do
  begin
    Create(tab);
    SetCaption('Potion type:');
    SetLeft(baseLeft + indent);
    SetTop(currentTop);
    SetFontColor($FFFFFF);
    GetFont.SetStyle([fsBold]);
  end;

  with Self.PotionSelector do
  begin
    Create(tab);
    SetLeft(baseLeft + indent);
    SetTop(Self.PotionLabel.GetTop() + Self.PotionLabel.GetHeight() + labelGap);
    SetWidth(controlWidth - indent);
    SetStyle(csDropDownList);
    AddItem('Combat', nil);
    AddItem('Attack', nil);
    AddItem('Strength', nil);
    AddItem('Super Attack', nil);
    AddItem('Super Strength', nil);
    AddItem('Super Combat', nil);
    AddItem('Ranging', nil);
    SetItemIndex(0);
  end;

  currentTop := Self.PotionSelector.GetTop() + Self.PotionSelector.GetHeight() + spacing + TControl.AdjustToDPI(20);

  with Self.BHRunsCheckbox do
  begin
    Create(tab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('bh_runs');
    SetCaption('Enable birdhouse runs');
    SetWidth(TControl.AdjustToDPI(450));
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetChecked(False);
  end;

  // Start button bottom-left, on the dark rocks below the field column and
  // clear of the character art on the right
  Self.Start.setVisible(False);
  with Self.Start do
  begin
    SetAlign(alNone);
    SetBounds(
      baseLeft,
      Self.Form.GetHeight() - TControl.AdjustToDPI(64),
      TControl.AdjustToDPI(150),
      TControl.AdjustToDPI(44)
    );
    SetCaption('Start');
    GetFont().SetName('Verdana');
    GetFont().SetSize(13);
    setVisible(True);
  end;

  // Account Manager Tab
  Self.AddTab('Account Manager');
  accountTab := Self.Tabs[High(Self.Tabs)];
  accountPanel := Self.CreateAccountManager(accountTab);
  accountPanel.SetTop(TControl.AdjustToDPI(160));
  SetChildsBoldFont(accountPanel);

  // The default layout puts the worlds memo at x=375, on top of the
  // selector/username edits (which end at x=405 on this form), with the
  // buttons jammed against both. Move the worlds group right (over the
  // character art, fine on this tab) and give the buttons their own row.
  amPassPanel := Self.Form.GetChild('am_pass_panel');
  amWorldsPanel := Self.Form.GetChild('am_worlds_panel');
  if (amWorldsPanel <> nil) and (amPassPanel <> nil) then
  begin
    amWorldsPanel.SetLeft(TControl.AdjustToDPI(450));
    amWorldsPanel.SetWidth(TControl.AdjustToDPI(280));
    amWorldsPanel.SetHeight(amPassPanel.GetTop() + amPassPanel.GetHeight() - amWorldsPanel.GetTop());
  end;

  amAddBtn := Self.Form.GetChild('am_add_button');
  amSaveBtn := Self.Form.GetChild('am_save_button');
  amDeleteBtn := Self.Form.GetChild('am_delete_button');
  if (amAddBtn <> nil) and (amSaveBtn <> nil) and (amDeleteBtn <> nil) and (amPassPanel <> nil) then
  begin
    currentTop := amPassPanel.GetTop() + amPassPanel.GetHeight() + TControl.AdjustToDPI(12);
    amAddBtn.SetLeft(TControl.AdjustToDPI(35));
    amAddBtn.SetTop(currentTop);
    amAddBtn.SetWidth(TControl.AdjustToDPI(120));
    amSaveBtn.SetLeft(amAddBtn.GetLeft() + amAddBtn.GetWidth() + TControl.AdjustToDPI(10));
    amSaveBtn.SetTop(currentTop);
    amSaveBtn.SetWidth(TControl.AdjustToDPI(130));
    amDeleteBtn.SetLeft(amSaveBtn.GetLeft() + amSaveBtn.GetWidth() + TControl.AdjustToDPI(10));
    amDeleteBtn.SetTop(currentTop);
    amDeleteBtn.SetWidth(TControl.AdjustToDPI(125));
    // Grow the panel so the relocated button row isn't clipped
    accountPanel.SetHeight(currentTop + amAddBtn.GetHeight() + TControl.AdjustToDPI(10));
  end;

  LoadConfig();

  abTab := Self.CreateAntibanManager();
  offset := TControl.AdjustToDPI(150);
  for i := 0 to abTab.getComponentCount() - 1 do
  begin
    child := abTab.GetComponent(i);
    child.SetTop(child.GetTop() + offset);
  end;
  SetChildsBoldFont(abTab);

  wlTab := Self.CreateWaspLibSettings();
  limitPanel := Self.Form.GetChild('limit_panel');
  riPanel := Self.Form.GetChild('ri_panel');
  vPanel := Self.Form.GetChild('v_panel');

  // Hide riPanel entirely (HUD checkboxes not needed)
  if riPanel <> nil then
    riPanel.SetVisible(False);

  offset := TControl.AdjustToDPI(160);
  currentY := offset;

  // Reposition limitPanel and stack its children vertically
  if limitPanel <> nil then
  begin
    limitPanel.SetAlign(alNone);
    limitPanel.SetTop(currentY);
    limitPanel.SetWidth(Self.Size.X);

    // Stack action limit and time limit vertically with consistent width
    actionLimitPanel := Self.Form.GetChild('wl_action_limit_panel');
    if actionLimitPanel <> nil then
    begin
      actionLimitPanel.SetLeft(TControl.AdjustToDPI(60));
      actionLimitPanel.SetWidth(TControl.AdjustToDPI(240));
      actionLimitPanel.SetTop(TControl.AdjustToDPI(20));
    end;

    timeLimitPanel := Self.Form.GetChild('wl_time_limit_panel');
    if timeLimitPanel <> nil then
    begin
      timeLimitPanel.SetLeft(TControl.AdjustToDPI(60));
      timeLimitPanel.SetWidth(TControl.AdjustToDPI(240));
      if actionLimitPanel <> nil then
        timeLimitPanel.SetTop(actionLimitPanel.GetTop() + actionLimitPanel.GetHeight() + TControl.AdjustToDPI(10))
      else
        timeLimitPanel.SetTop(TControl.AdjustToDPI(70));
    end;

    // Create CheckSettingsCheckbox inside limitPanel (below time limit)
    with Self.CheckSettingsCheckbox do
    begin
      Create(limitPanel);
      SetLeft(TControl.AdjustToDPI(60));
      SetName('check_game_settings');
      SetCaption('Check Game Settings');
      SetWidth(TControl.AdjustToDPI(240));
      SetFontColor($FFFFFF);
      Caption.GetFont().SetStyle([fsBold]);
      if timeLimitPanel <> nil then
        SetTop(timeLimitPanel.GetTop() + timeLimitPanel.GetHeight() + TControl.AdjustToDPI(10))
      else
        SetTop(TControl.AdjustToDPI(120));
      if Config.Has('checkGameSettings') then
        SetChecked(Config.GetBoolean('checkGameSettings'))
      else
        SetChecked(True);
    end;

    // Expand limitPanel height to fit stacked controls
    limitPanel.SetHeight(Self.CheckSettingsCheckbox.GetTop() + Self.CheckSettingsCheckbox.GetHeight() + TControl.AdjustToDPI(10));
    currentY := currentY + limitPanel.GetHeight();
  end;

  // Reposition vPanel below limitPanel, left-aligned
  if vPanel <> nil then
  begin
    vPanel.SetAlign(alNone);
    vPanel.SetTop(currentY);
    vPanel.SetLeft(0);
    vPanel.SetWidth(Self.Size.X);

    vEnabledPanel := Self.Form.GetChild('v_enabled_panel');
    if vEnabledPanel <> nil then
    begin
      vEnabledPanel.SetLeft(TControl.AdjustToDPI(60));
      vEnabledPanel.SetWidth(TControl.AdjustToDPI(240));
    end;

    vTimePanel := Self.Form.GetChild('v_time_panel');
    if vTimePanel <> nil then
    begin
      vTimePanel.SetLeft(TControl.AdjustToDPI(60));
      vTimePanel.SetWidth(TControl.AdjustToDPI(240));
    end;
  end;

  SetChildsBoldFont(wlTab);

  // Birdhouse Settings Tab (from birdhouserunner.simba)
  Self.CreateBirdhouseRunSettings();

  // ===== Discord Tab =====
  // Fields sit in the clear left column (below the title, left of the
  // character), matching the other tabs' baseLeft/baseTop/controlWidth.
  Self.AddTab('Discord');
  discordTab := Self.Tabs[High(Self.Tabs)];

  currentTop := baseTop;

  with Self.DiscordEnabledCheckbox do
  begin
    Create(discordTab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('discord_enabled');
    SetCaption('Enable Discord Notifications');
    SetWidth(controlWidth);
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetHint('Sends hourly reports, level-ups, and session summaries to a Discord channel via webhook.' + LineEnding + 'To create one: Server Settings > Integrations > Webhooks > New Webhook > Copy URL.');
    SetShowHint(True);
  end;

  currentTop := Self.DiscordEnabledCheckbox.GetTop() + Self.DiscordEnabledCheckbox.GetHeight() + spacing;

  with Self.DiscordAnonymousCheckbox do
  begin
    Create(discordTab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('discord_anonymous');
    SetCaption('Anonymous Screenshots');
    SetWidth(controlWidth);
    SetChecked(True);
    SetFontColor($FFFFFF);
    Caption.GetFont().SetStyle([fsBold]);
    SetHint('Hides your display name and XP bar in screenshots.' + LineEnding + 'Uncheck to include them. Screenshots are only sent to your webhook, never shared elsewhere.');
    SetShowHint(True);
  end;

  currentTop := Self.DiscordAnonymousCheckbox.GetTop() + Self.DiscordAnonymousCheckbox.GetHeight() + spacing;

  with Self.DiscordWebhookEdit do
  begin
    Create(discordTab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetName('discord_webhook');
    SetCaption('Webhook URL:');
    SetWidth(controlWidth);
    SetHeight(TControl.AdjustToDPI(36));
  end;

  currentTop := Self.DiscordWebhookEdit.GetTop() + Self.DiscordWebhookEdit.GetHeight() + spacing;

  with Self.DiscordTestButton do
  begin
    Init(discordTab);
    SetParent(discordTab);
    SetLeft(baseLeft);
    SetTop(currentTop);
    SetWidth(TControl.AdjustToDPI(115));
    SetHeight(TControl.AdjustToDPI(30));
    SetCaption('Test Webhook');
    SetOnClick(@Self.TestDiscordWebhook);
  end;

  helpBtn.Init(discordTab);
  helpBtn.SetParent(discordTab);
  helpBtn.SetLeft(Self.DiscordTestButton.GetRight() + TControl.AdjustToDPI(10));
  helpBtn.SetTop(Self.DiscordTestButton.GetTop());
  helpBtn.SetWidth(TControl.AdjustToDPI(115));
  helpBtn.SetHeight(TControl.AdjustToDPI(30));
  helpBtn.SetCaption('How to Set Up');
  helpBtn.SetOnClick(@Self.OpenWebhookHelp);

  // Load saved Discord settings
  if Config.Has('discordEnabled') then
    Self.DiscordEnabledCheckbox.SetChecked(Config.GetBoolean('discordEnabled'));
  if Config.Has('discordAnonymous') then
    Self.DiscordAnonymousCheckbox.SetChecked(Config.GetBoolean('discordAnonymous'));
  if Config.Has('discordWebhook') then
    Self.DiscordWebhookEdit.SetText(Config.GetString('discordWebhook'));

  Self.PageControl.SetChildsFontColor($FFFFFF);

  inherited;
end;
{$ENDIF}
{$ENDIF}

// -----------------------------------------------------------------------------
// Entry Point
// -----------------------------------------------------------------------------

begin
  {$IFDEF SCRIPT_GUI}
  ReanimationConfig.Run();
  {$ENDIF}
  SettingsHandler.CheckGPUPlugin();
  Bot.Run(WLSettings.MaxActions, WLSettings.MaxTime);
end.
