{$DEFINE SCRIPT_NAME := 'Orka Reanimation'}
{$DEFINE SCRIPT_DESCRIPTION := 'Reanimate ensouled heads at the Dark Altar for Prayer XP'}
{$DEFINE SCRIPT_REVISION := '8'}
{$DEFINE SCRIPT_SKILLS := 'prayer magic'}
{$DEFINE ORKA_LIBS := 'srl-t@7.21.48 wasplib@20.4.42'}

{$IFNDEF SCRIPT_CHAIN}
  {$DEFINE SCRIPT_GUI}
  program OrkaReanimation;
  {$I SRL-T/osr.simba}
  {$I WaspLib/osr.simba}
  {$I WaspLib/optional/handlers/teleports/transport.simba}
  {$I WaspLib/optional/handlers/birdhouserunner.simba}
  {$I WaspLib/optional/handlers/discord.simba}
{$ENDIF}

const
  SCRIPT_NAME = 'Orka Reanimation';
  VERBOSE_LOGGING = True;
  MIN_HEALTH_PERCENT = 40;
  SPEC_USE_CHANCE = 70;

  // Timing (ONE_SECOND / ONE_MINUTE / ONE_HOUR come from SRL-T)
  REPORT_FREQUENCY           = 5 * ONE_MINUTE;   // console report interval
  DISCORD_REPORT_FREQUENCY   = ONE_HOUR;         // Discord hourly report interval
  COMBAT_TIMEOUT             = 2 * ONE_MINUTE;   // hard cap on a single kill
  COMBAT_NO_ACTIVITY_TIMEOUT = 15 * ONE_SECOND;  // no XP/combat this long => done
  SPEC_ATTEMPT_INTERVAL      = 7 * ONE_SECOND;   // how often to try a spec in combat

  // How far (in tiles) a small reanimated monster's minimap dot can sit from
  // the player while in melee. 1 tile = 4 minimap px; the slack covers diagonal
  // adjacency (~5.7px) and the ~3px dot-anchor jitter of Minimap.GetDots.
  // Large monsters (dragons etc.) need their own measured radius before this
  // check can apply to them.
  SMALL_MONSTER_DOT_TILES = 1;
  ADJACENT_NPC_DOT_RADIUS = SMALL_MONSTER_DOT_TILES * 4 + 6; // minimap px

  REPORT_BANNER_WIDTH = 42;

  // Reanimation cast-failure recovery thresholds (consecutive failures)
  CAST_RECOVERY_THRESHOLD = 2; // clear any stuck spell/item selection
  CAST_FAILURE_LIMIT      = 6; // force a recovery bank trip to fully reset state

  // Retry / attempt limits
  MAX_BANK_OPEN_ATTEMPTS = 5; // retries when opening the bank
  MAX_TELEPORT_ATTEMPTS  = 5; // retries for spellbook / ring teleports
  MAX_BANK_TELEPORT_FAILURES = 4; // abort after this many consecutive failed bank teleports (anti-infinite-loop)
  MAX_ATTACK_ATTEMPTS    = 5; // abandon a spawn after this many failed attacks
  MAX_HOP_ATTEMPTS       = 5; // retries for a single world hop before giving up
  WALK_ROTATE_THRESHOLD  = 3; // rotate camera after this many walk failures
  WALK_MINIMAP_THRESHOLD = 6; // direct minimap click after this many walk failures

  // Camera zoom
  ANTIBAN_MIN_ZOOM = 15;
  ANTIBAN_MAX_ZOOM = 50;
  BH_MIN_ZOOM      = 10; // zoomed out for Fossil Island navigation
  BH_MAX_ZOOM      = 20;

  // Player-hop: world-hop away from anyone who sets up and trains at our spot.
  // Passers-by on the through-route are ignored; only a player who lingers in
  // the same neighbourhood long enough counts. A reanimation trainer drifts a
  // few tiles each cycle (cast -> kill the spawn -> walk back), so the cluster
  // radius is generous, while the dwell time filters anyone just walking past.
  HOP_FOR_PLAYERS       = True;            // master switch - set False to disable player-hopping
  HOP_SCAN_INTERVAL     = 2 * ONE_SECOND;  // how often to sample player dots
  HOP_DWELL_TIME        = 20 * ONE_SECOND; // linger time before treated as a trainer
  HOP_CANDIDATE_TIMEOUT = 6 * ONE_SECOND;  // forget a player not re-seen this long (passer-by left)
  HOP_CLUSTER_RADIUS    = 28;              // walker units (~7 tiles): roam allowance for one lingering player
  // OSRS blocks logout/hop for ~10s after the last hit. We hop right before the
  // next cast (freshly out of combat), so wait out that window before trying.
  HOP_COMBAT_COOLDOWN_MIN = 8 * ONE_SECOND;
  HOP_COMBAT_COOLDOWN_MAX = 10 * ONE_SECOND;

  // Arrival check: right after arriving at the casting spot (walk-in, post-bank,
  // post-hop) watch the minimap briefly; if someone is already lingering, hop
  // before wasting the first cast. Passers-by clear out in ~2-3s, so requiring
  // ARRIVAL_MIN_PRESENCE of continuous presence filters them.
  ARRIVAL_WATCH_TIME    = 6 * ONE_SECOND;  // max observation window after arrival
  ARRIVAL_MIN_PRESENCE  = 4 * ONE_SECOND;  // continuous presence that counts as camped
  ARRIVAL_SCAN_INTERVAL = 600;             // ms between dot samples during the watch

  // Player-hopping draws its worlds from the account's Account Manager list and
  // activates only when that list holds at least this many. World designations
  // drift over time (Jagex repurposes worlds for PvP / skill-total / seasonal),
  // so we never hardcode a list here - the Account Manager is the single source.
  MIN_HOP_WORLDS = 5;

  // Prayer XP Drop DTM for kill detection
  PRAYER_XP_DTM = 'mGQAAAHicY2RgYLjFyMDQD6Qfvr/OAAKMIAIAO4oEFA==';

  // Area definitions
  ARCEUUS_AREA: TBox = [2332, 34826, 2900, 35162];
  ARCEUUS_LIBRARY_BOX: TBox = [2400, 35050, 2472, 35098];
  FEROX_ENCLAVE_BOX: TBox = [8350, 35850, 8550, 36000];

  // Altar positioning tiles
  ALTAR_START_TILE: TPoint = [2744, 34910];
  ALTAR_RESET_TILE: TPoint = [2716, 34910];

  // Ring of dueling chat message when crumbled
  RING_CRUMBLED_MESSAGE = 'crumbles to dust';
  NO_ROOM_MESSAGE = 'room to re-animate';

type
  EHeadType = (
    HEAD_ABYSSAL,
    HEAD_AVIANSIE,
    HEAD_BEAR,
    HEAD_BLOODVELD,
    HEAD_CHAOS_DRUID,
    HEAD_DAGANNOTH,
    HEAD_DEMON,
    HEAD_DOG,
    HEAD_DRAGON,
    HEAD_ELF,
    HEAD_GIANT,
    HEAD_GOBLIN,
    HEAD_HELLHOUND,
    HEAD_HORROR,
    HEAD_IMP,
    HEAD_KALPHITE,
    HEAD_MINOTAUR,
    HEAD_MONKEY,
    HEAD_OGRE,
    HEAD_SCORPION,
    HEAD_TROLL,
    HEAD_TZHAAR,
    HEAD_UNICORN
  );

  EReanimationState = (
    HANDLE_LOGIN,
    TELEPORT_TO_BANK,
    USE_POOL,
    OPEN_BANK,
    HANDLE_BANK,
    CLOSE_BANK,
    TELEPORT_TO_ARCEUUS,
    WALK_TO_ALTAR,
    CAST_REANIMATE,
    WAIT_SPAWN,
    ATTACK_MONSTER,
    WAIT_COMBAT_END,
    RESET_POSITION,
    DO_ANTIBAN,
    EMERGENCY_HEAL,
    WORLD_HOP,
    END_SCRIPT
  );

  EPotionType = (
    POTION_COMBAT,
    POTION_ATTACK,
    POTION_STRENGTH,
    POTION_SUPER_ATTACK,
    POTION_SUPER_STRENGTH,
    POTION_SUPER_COMBAT,
    POTION_RANGING
  );

  // One tracked nearby player: a cluster anchored where the player was first
  // seen, refreshed each scan they stay within HOP_CLUSTER_RADIUS of it.
  TPlayerCandidate = record
    Pos: TPoint;              // anchor tile (world coords)
    FirstSeen, LastSeen: Int64;
    Samples: Int32;
  end;
  TPlayerCandidateArray = array of TPlayerCandidate;

  TReanimationBot = record(TBaseWalkerScript)
    State: EReanimationState;

    // Configuration
    HeadType: EHeadType;
    HeadItem: TRSItem;
    ReanimationSpell: ERSSpell;
    DoBHRuns: Boolean;
    UseSpecs: Boolean;
    UseQuickPrayers: Boolean;
    UseBankPotion: Boolean;
    BankPotion: EPotionType;

    // Position tracking
    CurrentTile: TPoint;
    SpawnTile: TPoint;

    // Combat tracking
    IsInCombat: Boolean;
    MonsterSpawned: Boolean;
    HasReachedStartTile: Boolean;
    AttackAttempts: Int32;
    WalkFailureCount: Int32;
    CastFailureCount: Int32;  // Consecutive reanimation cast failures (stuck-state detection)
    ForceBank: Boolean;       // Forces a recovery bank trip after repeated cast failures

    // Ferox Enclave tracking
    HasUsedPool: Boolean;       // True after using pool, reset when banking complete
    NeedsNewRing: Boolean;      // True when ring crumbled, need to get new one from bank
    NeedsManualReset: Boolean;  // True when "no room" message seen
    NeedsEmergencyHeal: Boolean; // True when HP is low, need to teleport to Ferox for healing
    LastNoRoomCount: Int32;     // Track number of "no room" messages to detect new ones
    BankTeleportFailures: Int32; // Consecutive failed bank teleports; aborts past MAX_BANK_TELEPORT_FAILURES

    // Stats
    HeadsUsed, MonstersKilled: Int32;
    HeadPendingXP: Boolean; // True after consuming a head until a prayer XP drop is seen
    HeadCount: Int32;  // Current heads in inventory

    // Break tracking
    TotalBreakTime, LastBreakStartTime, LastBreakEndTime: Int64;

    // Birdhouse run tracking
    LastBHRunEndTime: Int64;

    // Report timer
    ReportTimer: TStopwatch;

    // Spec Attack Logic
    WeaponSpecCost: Int32;

    // Potion availability cache
    CombatPotionUnavailable: Boolean;   // True when combat potion withdrawal fails
    AntifirePotionUnavailable: Boolean; // True when both antifire variants fail
    CachedAntifireName: String;         // Caches which antifire variant was found

    // Run verification
    VerifiedSpells: Boolean;

    // Game settings check
    CheckGameSettings: Boolean;

    // Discord
    UseDiscord: Boolean;
    AnonymousScreenshots: Boolean;
    DiscordReportTimer: TCountDown;

    // Prayer XP / level baseline (Time-to-Level + report stats)
    StartPrayerXP: Int32;
    StartPrayerLevel: Int32;

    // Player-hop: world-hop away from someone training at our spot
    PlayerCandidates: TPlayerCandidateArray;
    RecentWorlds: TIntegerArray;     // worlds used recently, avoided on the next hop
    HopScanTimer: TStopwatch;
    PendingHop: Boolean;             // set when a trainer is detected; hop before the next cast
    HopDisabledLogged: Boolean;      // log the "too few worlds" notice only once
    HopWithoutCombatWait: Boolean;   // arrival-triggered hop: no combat happened, skip the post-combat wait
    ConsecutiveHops: Int32;          // successful hops without settling at a free spot; aborts past 2x the world list

  end;


var
  Bot: TReanimationBot;
  Config: TConfigJSON;
  Discord: TDiscordClient;

// -----------------------------------------------------------------------------
// Head Type Mappings
// -----------------------------------------------------------------------------

(**
 * GetHeadItemName
 *
 * Returns the full item name for a given head type.
 *
 * @param headType  The enum value of the head
 * @return          The string name of the item
 *)
function GetHeadItemName(headType: EHeadType): String;
begin
  case headType of
    HEAD_ABYSSAL:     Result := 'Ensouled abyssal head';
    HEAD_AVIANSIE:    Result := 'Ensouled aviansie head';
    HEAD_BEAR:        Result := 'Ensouled bear head';
    HEAD_BLOODVELD:   Result := 'Ensouled bloodveld head';
    HEAD_CHAOS_DRUID: Result := 'Ensouled chaos druid head';
    HEAD_DAGANNOTH:   Result := 'Ensouled dagannoth head';
    HEAD_DEMON:       Result := 'Ensouled demon head';
    HEAD_DOG:         Result := 'Ensouled dog head';
    HEAD_DRAGON:      Result := 'Ensouled dragon head';
    HEAD_ELF:         Result := 'Ensouled elf head';
    HEAD_GIANT:       Result := 'Ensouled giant head';
    HEAD_GOBLIN:      Result := 'Ensouled goblin head';
    HEAD_HELLHOUND:   Result := 'Ensouled hellhound head';
    HEAD_HORROR:      Result := 'Ensouled horror head';
    HEAD_IMP:         Result := 'Ensouled imp head';
    HEAD_KALPHITE:    Result := 'Ensouled kalphite head';
    HEAD_MINOTAUR:    Result := 'Ensouled minotaur head';
    HEAD_MONKEY:      Result := 'Ensouled monkey head';
    HEAD_OGRE:        Result := 'Ensouled ogre head';
    HEAD_SCORPION:    Result := 'Ensouled scorpion head';
    HEAD_TROLL:       Result := 'Ensouled troll head';
    HEAD_TZHAAR:      Result := 'Ensouled tzhaar head';
    HEAD_UNICORN:     Result := 'Ensouled unicorn head';
  end;
end;

(**
 * GetReanimationSpell
 *
 * Maps a head type to the required reanimation spell tier.
 *
 * @param headType  The head to reanimate
 * @return          The required spell enum
 *)
function GetReanimationSpell(headType: EHeadType): ERSSpell;
begin
  case headType of
    HEAD_BEAR, HEAD_GOBLIN, HEAD_IMP, HEAD_MINOTAUR,
    HEAD_MONKEY, HEAD_SCORPION, HEAD_UNICORN:
      Result := ERSSpell.BASIC_REANIMATION;

    HEAD_CHAOS_DRUID, HEAD_DOG, HEAD_ELF, HEAD_GIANT,
    HEAD_HORROR, HEAD_OGRE, HEAD_TROLL:
      Result := ERSSpell.ADEPT_REANIMATION;

    HEAD_BLOODVELD, HEAD_DAGANNOTH, HEAD_DEMON,
    HEAD_HELLHOUND, HEAD_KALPHITE, HEAD_TZHAAR:
      Result := ERSSpell.EXPERT_REANIMATION;

    HEAD_ABYSSAL, HEAD_AVIANSIE, HEAD_DRAGON:
      Result := ERSSpell.MASTER_REANIMATION;
  end;
end;

